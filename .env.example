# ProjectBrain Environment Configuration Template
# DO NOT COMMIT REAL CREDENTIALS OR API KEYS TO GIT

# Local AI / LLM Configuration (Default: completely local)
PB_AI_MODE=offline # options: offline | local | cloud | automatic
PB_OLLAMA_ENDPOINT=http://localhost:11434
PB_LOCAL_MODEL=qwen2.5-coder:7b

# Optional Cloud LLM (Only if explicitly enabled by user)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Storage & Logging
PB_LOG_LEVEL=info # options: debug | info | warn | error
